{
  "name": "pedl-bricks-to-blocks-materials",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "lint:format": "prettier --check .",
    "lint:html": "html-validate index.html en/index.html 404.html",
    "lint": "npm run build && npm run lint:js && npm run lint:css && npm run lint:format && npm run lint:html",
    "test": "npm run build && node --test",
    "check": "npm run build && npm run lint:js && npm run lint:css && npm run lint:format && npm run lint:html && node --test",
    "perf": "npm run build && node scripts/perf-audit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^9.5.0",
    "lighthouse": "^12.6.0",
    "lightningcss-cli": "^1.30.1",
    "prettier": "^3.5.3",
    "stylelint": "^16.16.0",
    "stylelint-config-standard": "^38.0.0"
  }
}
